{
  "name": "tac-board",
  "version": "1.0.0",
  "description": "Real-time collaborative soccer tactical board",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "stress:suite": "node stress-suite.js",
    "stress:20": "node -e \"process.env.USERS='20'; require('./stress-suite.js')\"",
    "stress:20:soak5m": "node -e \"process.env.USERS='20'; process.env.SOAK_DURATION_MS='300000'; require('./stress-suite.js')\""
  },
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.19.0",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "socket.io-client": "^4.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
